        "billing": {"type": "object", "properties": {"stripe_customer": {"type": "boolean"}}},
        "settings": {"type": "object"}, "controller": {"type": ["object", "null"]}, "dpia": {"type": ["object", "null"]}, "ready_for_jobs": {"type": "boolean"},
        "missing": {"type": "array", "items": {"enum": ["controller", "dpia"]}}, "webhook_secret": {"type": "string", "description": "Only when PATCH settings just created it"}}},
      "ApiKey": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": ["string", "null"]}, "prefix": {"type": "string"}, "scopes": {"type": "array", "items": {"$ref": "#/components/schemas/Scope"}},
        "created_at": {"type": "string"}, "last_used_at": {"type": ["string", "null"]}, "revoked_at": {"type": ["string", "null"]}}},
      "ApiKeyWithSecret": {"allOf": [{"$ref": "#/components/schemas/ApiKey"}, {"type": "object", "properties": {"secret": {"type": "string", "pattern": "^rfpii_live_[0-9A-Za-z]{43}$"}}}]},
      "FreeForms": {"type": "object", "description": "The month's free forms (FREE_FORMS_PER_MONTH, calendar month UTC)",
        "properties": {"period": {"type": "string"}, "per_month": {"type": "integer"}, "used": {"type": "integer"}, "reserved": {"type": "integer"}, "left": {"type": "integer"}}},
