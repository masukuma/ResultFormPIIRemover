      "Settings": {"type": "object", "additionalProperties": false, "properties": {"held_pages": {"enum": ["none", "cloud"]}, "webhook_url": {"type": ["string", "null"], "format": "uri"}}},
      "Account": {"type": "object", "properties": {"id": {"type": "string"}, "object": {"const": "account"}, "name": {"type": "string"}, "email": {"type": ["string", "null"]}, "period": {"type": "string"},
        "forms_released_this_month": {"type": "integer", "description": "Forms counted this month, free and from credits"},
        "free_forms": {"$ref": "#/components/schemas/FreeForms"}, "credits": {"$ref": "#/components/schemas/Credits"}, "purchases": {"$ref": "#/components/schemas/PurchasesSummary"},
        "price": {"type": "object", "properties": {"currency": {"const": "usd"}, "package_forms": {"type": "integer"}, "package_price_cents": {"type": "integer"}, "price_per_form_usd": {"type": "string"},
