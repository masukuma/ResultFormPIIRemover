          "lines": {"type": "array", "items": {"$ref": "#/components/schemas/QuoteLine"}}, "net_cents": {"type": "integer"}, "card_fee_cents": {"type": "integer"},
          "vat_rate_basis_points": {"type": "integer"}, "vat_net_cents": {"type": "integer"}, "vat_card_fee_cents": {"type": "integer"}, "vat_cents": {"type": "integer"},
          "total_cents": {"type": "integer"}, "total_usd": {"type": "string"}, "effective_price_per_form_usd": {"type": "string"}}},
      "Purchase": {"type": "object", "properties": {"id": {"type": "string"}, "object": {"const": "purchase"}, "status": {"enum": ["pending", "paid", "expired", "mismatch"]},
        "method": {"enum": ["stripe", "manual"]}, "packages": {"type": "integer"}, "forms": {"type": "integer"}, "currency": {"const": "usd"},
        "lines": {"type": "array", "items": {"$ref": "#/components/schemas/QuoteLine"}}, "net_cents": {"type": "integer"}, "card_fee_cents": {"type": "integer"},
        "vat_rate_basis_points": {"type": "integer"}, "vat_cents": {"type": "integer"}, "total_cents": {"type": "integer"}, "total_usd": {"type": "string"},
        "reference": {"type": ["string", "null"], "description": "The operator's reference of a manual purchase"}, "stripe_session_id": {"type": ["string", "null"]},
        "amount_received_cents": {"type": ["integer", "null"]}, "currency_received": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}, "paid_at": {"type": ["string", "null"]}, "closed_at": {"type": ["string", "null"], "description": "When it was found expired or mismatched"}}},
      "PurchaseList": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Purchase"}}, "has_more": {"type": "boolean"}, "next_after": {"type": ["string", "null"]}}},
      "AdminAccount": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "email": {"type": ["string", "null"]}, "credits": {"$ref": "#/components/schemas/Credits"},
