                       "available": {"type": "integer"}, "expire_after_days": {"type": ["integer", "null"], "description": "CREDIT_EXPIRY_DAYS; null: credits don't expire"}}},
      "PurchasesSummary": {"type": "object", "properties": {"paid": {"type": "integer"}, "pending": {"type": "integer"}, "expired": {"type": "integer"}, "mismatch": {"type": "integer"},
        "forms_bought": {"type": "integer"}, "total_paid_cents": {"type": "integer"}, "total_paid_usd": {"type": "string"}, "last_paid_at": {"type": ["string", "null"], "format": "date-time"}}},
      "QuoteLine": {"type": "object", "properties": {"item": {"enum": ["packages", "card_fee"]}, "description": {"type": "string"}, "quantity": {"type": "integer"},
