        "records": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "job_id": {"type": "string"}, "forms": {"type": "integer"}, "free_forms": {"type": "integer"},
          "credit_forms": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"},
          "legacy": {"type": "object", "description": "Only on records made under the metered plan: its plan, unit price and amount"}}}},
        "forms": {"type": "integer"}, "free_forms": {"type": "integer"}, "credit_forms": {"type": "integer"},
        "reserved": {"type": "object", "properties": {"free_forms": {"type": "integer"}, "credits": {"type": "integer"}}},
        "free": {"$ref": "#/components/schemas/FreeForms"}, "credits": {"$ref": "#/components/schemas/Credits"}, "purchases": {"$ref": "#/components/schemas/PurchasesSummary"}}},
      "Pricing": {"type": "object", "properties": {"currency": {"const": "usd"}, "unit": {"const": "form"},
        "free": {"type": "object", "properties": {"forms_per_month": {"type": "integer"}, "period": {"type": "string"}}},
        "package": {"type": "object", "properties": {"forms": {"type": "integer"}, "price_cents": {"type": "integer"}, "price_usd": {"type": "string"}, "price_per_form_usd": {"type": "string"},
          "max_per_purchase": {"type": "integer"}, "credits_expire_after_days": {"type": ["integer", "null"]}}},
        "card_fee": {"type": "object", "properties": {"basis_points": {"type": "integer"}, "fixed_cents": {"type": "integer"}, "terms": {"type": "string"}, "paid_by": {"type": "string"}}},
        "vat": {"type": "object", "properties": {"rate_basis_points": {"type": "integer"}, "rate": {"type": "string"}, "on": {"type": "array", "items": {"type": "string"}}, "included_in_prices": {"const": false}}},
        "quote": {"$ref": "#/components/schemas/Quote"}, "checkout": {"type": "boolean", "description": "Whether card payments by Stripe Checkout are configured"},
        "how_the_price_was_set": {"type": "string", "format": "uri"}}},
      "Verification": {"type": "object", "properties": {"verified": {"type": "boolean"}, "checks": {"type": "array", "items": {"type": "object", "properties": {"ok": {"type": "boolean"}, "text": {"type": "string"}}}},
        "notes": {"type": "array", "items": {"type": "string"}}, "result": {"type": ["string", "null"]}}}
    }
