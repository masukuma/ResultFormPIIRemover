          "id": {"type": "string"}, "object": {"const": "job"}, "status": {"enum": ["queued", "running", "succeeded", "failed", "canceled"]},
          "cancel_requested": {"type": "boolean"}, "file_ids": {"type": "array", "items": {"type": "string"}}, "instructions": {"type": ["string", "null"]},
          "policy": {"type": ["object", "null"]}, "per_page": {"type": ["string", "null"]},
          "held_pages": {"enum": ["none", "cloud"], "description": "The account's setting when the job was created: whether held pages may go to the cloud vision model"}, "webhook_url": {"type": ["string", "null"]}, "metadata": {"type": ["object", "null"]},
          "forms_requested": {"type": "integer"}, "forms_released": {"type": ["integer", "null"]}, "forms_held": {"type": ["integer", "null"]},
          "inventory": {"type": ["object", "null"]},
